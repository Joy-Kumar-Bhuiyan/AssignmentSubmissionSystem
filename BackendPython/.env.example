# PostgreSQL for local or deployed environments. For a lightweight local demo,
# omit DATABASE_URL and SQLite will create school_portal.db automatically.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/school_portal

# Generate a long random value before deployment; never commit a real secret.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_ISSUER=SchoolPortalApi
JWT_AUDIENCE=SchoolPortalFrontend
ACCESS_TOKEN_MINUTES=1440
CORS_ORIGINS=http://localhost:5173
